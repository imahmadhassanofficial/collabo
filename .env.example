# Copy this file to .env for local dev (npm run dev). On Vercel, add the same keys under Project > Settings > Environment Variables.

# Required for the chat assistant
ANTHROPIC_API_KEY=
# Optional: model used by the chat (default claude-haiku-5-5)
CLAUDE_MODEL=

# Optional: "Leave your details" form in the chat (emails leads via Resend)
RESEND_API_KEY=
LEAD_TO_EMAIL=info@collaboLLC.com
LEAD_FROM_EMAIL=
