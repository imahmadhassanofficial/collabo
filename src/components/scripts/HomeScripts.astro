<script is:inline>
  gsap.registerPlugin(SplitText);

function initButton004() {
  const buttons = document.querySelectorAll('[data-button-004]');
  if (buttons.length === 0) return;

  buttons.forEach((element) => {
    const textElements = element.querySelectorAll('[data-button-004-text]');
    if (textElements.length === 0) return;

    textElements.forEach((textElement) => {
      const splitText = new SplitText(textElement, {
        type: 'chars',
        tag: 'span',
        charsClass: 'button-004__split-char',
      });

      const chars = splitText.chars;
      const count = chars.length;
      const center = (count - 1) / 2;
      const maxIndex = Math.floor(center);

      textElement.style.setProperty('--max-index', maxIndex);

      chars.forEach((char, index) => {
        const distance = Math.floor(Math.abs(index - center));
        let signedIndex = 0;

        if (index < center) {
          signedIndex = distance;
        } else if (index > center) {
          signedIndex = -distance;
        }

        char.style.setProperty('--index', distance);
        char.style.setProperty('--signed-index', signedIndex);
      });
    });
  });
}

// Inialize Button 004
document.addEventListener('DOMContentLoaded', () => {
  initButton004();
});
</script><script is:inline>
function initRadialCardsMarquee() {
  document.querySelectorAll('[data-radial-cards-marquee-list]').forEach((list) => {
    const total = parseInt(getComputedStyle(list).getPropertyValue('--total'), 10) || list.children.length;
    const originals = [...list.children];
    if (!total || !originals.length) return;

    // Trim or clone until child count matches --total
    while (list.children.length > total) list.lastElementChild.remove();
    for (let i = list.children.length; i < total; i++) {
      const clone = originals[i % originals.length].cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      list.appendChild(clone);
    }

    // Keep CSS and DOM in sync
    list.style.setProperty('--total', total);
    [...list.children].forEach((item, i) => item.style.setProperty('--card', i + 1));

    // Pause animation when the wheel is off-screen
    const observer = new IntersectionObserver(([entry]) => {
      list.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused';
    }, { rootMargin: '10%' });
    observer.observe(list.closest('.radial-cards-marquee') || list);
  });
}

document.addEventListener('DOMContentLoaded', initRadialCardsMarquee);
</script>

