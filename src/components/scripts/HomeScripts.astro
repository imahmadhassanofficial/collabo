<script is:inline>
  const colors = ["#ED6673","#F98670","#26AEEE","#306BE7","#5A4FE0","#864EE3","#9B2EC2"];
  const el = document.querySelector('.hero_game_container');
  const proxy = { c: colors[0] };
  let i = 0;

  el.style.backgroundImage = `radial-gradient(circle, ${proxy.c}, #131313)`;

  function next() {
    const target = colors[(i + 1) % colors.length];
