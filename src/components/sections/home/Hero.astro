<style is:global>
  .hx-eyebrow {
    margin: 0 0 .4vw; font: 600 12px/1.4 'Be Vietnam Pro', sans-serif; letter-spacing: .18em; text-transform: uppercase;
    background: linear-gradient(90deg, #26aeee, #5a4fe0, #9b2ec2, #ed6673, #f98670); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hx-eyebrow span { padding: 0 .4em; }
  .hx-grad {
    background: linear-gradient(90deg, #f98670, #ed6673 35%, #9b2ec2 70%, #5a4fe0); -webkit-background-clip: text; background-clip: text; color: transparent;
    padding-right: .04em;
  }
  html body .hero_game_content .description_hero_game ._22_p:not(#_z) { color: rgba(255, 255, 255, .72); }
  .hx-ctas { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: .8vw; }
  .hx-btn, .hx-link { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 500 15px/1 'Be Vietnam Pro', sans-serif; white-space: nowrap; }
  .hx-btn {
    height: 52px; padding: 0 26px; border-radius: 99px; color: #04091a; background: #ed6673;
    box-shadow: 0 14px 34px -14px rgba(237, 102, 115, .9); transition: transform .2s, background-color .2s;
  }
  .hx-btn:hover { transform: translateY(-2px); background: #f98670; }
  .hx-link { color: #fff; padding: 14px 4px; border-bottom: 1px solid rgba(255, 255, 255, .35); border-radius: 0; height: auto; padding-bottom: 6px; }
  .hx-link:hover { border-color: #f98670; }
  .hx-btn svg, .hx-link svg { transition: translate .2s; }
  .hx-btn:hover svg, .hx-link:hover svg { translate: 3px 0; }
  .hx-btn:focus-visible, .hx-link:focus-visible { outline: 2px solid #26aeee; outline-offset: 4px; }
  .hx-trust { list-style: none; margin: 1vw 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 0; }
  .hx-trust li { padding: 0 14px; font: 500 12px/1.4 'Be Vietnam Pro', sans-serif; color: rgba(255, 255, 255, .62); border-left: 1px solid rgba(255, 255, 255, .16); }
  .hx-trust li:first-child, .hx-trust li:nth-child(2) { border-left: 0; }
  .hx-trust__label { color: rgba(255, 255, 255, .42) !important; font-weight: 400 !important; }
  @media (max-width: 599px) {
    .hx-eyebrow { font-size: 11px; letter-spacing: .14em; }
    .hx-ctas { flex-direction: column; align-items: stretch; width: 100%; gap: 14px; }
    .hx-btn { justify-content: center; height: 52px; }
    .hx-link { align-self: center; }
    .hx-trust li { padding: 0 10px; font-size: 11px; }
    .hx-trust__label { width: 100%; text-align: center; border: 0 !important; }
    .hx-trust li:nth-child(2) { border-left: 0; }
  }
</style>
