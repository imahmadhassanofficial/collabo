<div class="div-block-2"><section><div class="card-stack"><div class="card-stack__item a"><div class="card_containers _4"><div class="service_content_head"><div class="tag_block_container"><div class="_22_p _600">01</div></div><div class="head_service_inner"><div class="_48_heading">Interactive Ad Development</div><div class="service_inner_contain"><div class="_20_p">We design and develop high-impact HTML5 ads built to capture attention and drive engagement.</div></div></div><div class="service_list_container"><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Gamified Ads</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Store Locator Ads</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Pause Ads</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Rich Media Experiences</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Social Ad Adaptations</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Dynamic Creative Ads (DCO)</div></div></div><div class="service_inner_contain"><div class="_20_p">All creatives are custom built and optimized for performance.</div></div></div><div class="service_card_image"><img src="/webflow/images/6aae7ea4b5558e4668d9cfba_ChatGPT-Image-Sep-19-2026-05_21_55-PM.png" loading="lazy" sizes="(max-width: 1351px) 100vw, 1351px" srcset="/webflow/images/6aae7ea4b5558e4668d9cfba_ChatGPT-Image-Sep-19-2026-05_21_55-PM-p-500.png 500w, /webflow/images/6aae7ea4b5558e4668d9cfba_ChatGPT-Image-Sep-19-2026-05_21_55-PM-p-800.png 800w, /webflow/images/6aae7ea4b5558e4668d9cfba_ChatGPT-Image-Sep-19-2026-05_21_55-PM-p-1080.png 1080w, /webflow/images/6aae7ea4b5558e4668d9cfba_ChatGPT-Image-Sep-19-2026-05_21_55-PM.png 1351w" alt="" class="service_image"/></div></div></div><div class="card-stack__item is--2"><div class="card_containers _2"><div class="service_content_head"><div class="tag_block_container"><div class="_22_p _600">02</div></div><div class="head_service_inner"><div class="_48_heading">Video Advertising Solutions</div><div class="service_inner_contain"><div class="_20_p">We develop and deliver advanced video ad experiences across modern platforms.</div></div></div><div class="service_list_container"><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">VAST Video Ads</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Interactive Video Ads</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">CTV / OTT Ads</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Streaming Platform Ads</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Custom Video Ad Integrations</div></div></div><div class="service_inner_contain"><div class="_20_p">We also enhance video ad delivery by extending platform capabilities with custom solutions.</div></div></div><div class="service_card_image"><img src="/webflow/images/6aae7f65146a330691cbc11b_ChatGPT-Image-Sep-19-2026-05_25_58-PM.png" loading="lazy" sizes="(max-width: 1536px) 100vw, 1536px" srcset="/webflow/images/6aae7f65146a330691cbc11b_ChatGPT-Image-Sep-19-2026-05_25_58-PM-p-500.png 500w, /webflow/images/6aae7f65146a330691cbc11b_ChatGPT-Image-Sep-19-2026-05_25_58-PM-p-800.png 800w, /webflow/images/6aae7f65146a330691cbc11b_ChatGPT-Image-Sep-19-2026-05_25_58-PM-p-1080.png 1080w, /webflow/images/6aae7f65146a330691cbc11b_ChatGPT-Image-Sep-19-2026-05_25_58-PM.png 1536w" alt="" class="service_image"/></div></div></div><div class="card-stack__item is--3"><div class="card_containers _3"><div class="service_content_head"><div class="tag_block_container"><div class="_22_p _600">03</div></div><div class="head_service_inner"><div class="_48_heading">Ad Serving Infrastructure</div><div class="service_inner_contain"><div class="_20_p">Collabo provides a robust ad hosting and delivery infrastructure designed for modern programmatic advertising.</div></div></div><div class="service_list_container"><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">HTML5 Ads</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Video Ads</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">CTV / OTT</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">VAST</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">VPAID</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">SIMID</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Dynamic Creative Optimization</div></div></div><div class="service_inner_contain"><div class="_20_p">Our infrastructure allows advertisers to deliver ad tags instead of heavy creative assets, simplifying campaign deployment across platforms.</div></div></div><div class="service_card_image"><img src="/webflow/images/6aae7ff56b8c07d06259aa07_ChatGPT-Image-Sep-19-2026-05_28_23-PM.png" loading="lazy" sizes="(max-width: 1536px) 100vw, 1536px" srcset="/webflow/images/6aae7ff56b8c07d06259aa07_ChatGPT-Image-Sep-19-2026-05_28_23-PM-p-500.png 500w, /webflow/images/6aae7ff56b8c07d06259aa07_ChatGPT-Image-Sep-19-2026-05_28_23-PM-p-800.png 800w, /webflow/images/6aae7ff56b8c07d06259aa07_ChatGPT-Image-Sep-19-2026-05_28_23-PM-p-1080.png 1080w, /webflow/images/6aae7ff56b8c07d06259aa07_ChatGPT-Image-Sep-19-2026-05_28_23-PM.png 1536w" alt="" class="service_image"/></div></div></div><div class="card-stack__item is--4"><div class="card_containers"><div class="service_content_head"><div class="tag_block_container"><div class="_22_p _600">04</div></div><div class="head_service_inner"><div class="_48_heading">DSP &amp; Platform Integrations</div><div class="service_inner_contain"><div class="_20_p">We ensure all ads are fully compatible with major DSPs and ad platforms.</div></div></div><div class="service_list_container"><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Google Ad Manager</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">DV360</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Yahoo DSP</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Xandr</div></div></div><div class="service_inner_contain"><div class="_20_p">We also ensure that all required macros and tracking parameters are correctly implemented for each platform.</div></div></div><div class="service_card_image"><img src="/webflow/images/6aae8097dcf871bb13f9a139_ChatGPT-Image-Sep-19-2026-05_31_06-PM.png" loading="lazy" sizes="(max-width: 1536px) 100vw, 1536px" srcset="/webflow/images/6aae8097dcf871bb13f9a139_ChatGPT-Image-Sep-19-2026-05_31_06-PM-p-500.png 500w, /webflow/images/6aae8097dcf871bb13f9a139_ChatGPT-Image-Sep-19-2026-05_31_06-PM-p-800.png 800w, /webflow/images/6aae8097dcf871bb13f9a139_ChatGPT-Image-Sep-19-2026-05_31_06-PM-p-1080.png 1080w, /webflow/images/6aae8097dcf871bb13f9a139_ChatGPT-Image-Sep-19-2026-05_31_06-PM.png 1536w" alt="" class="service_image"/></div></div></div><div class="card-stack__item is--5"><div class="card_containers _5"><div class="service_content_head"><div class="tag_block_container"><div class="_22_p _600">05</div></div><div class="head_service_inner"><div class="_48_heading">Tracking &amp; Analytics</div><div class="service_inner_contain"><div class="_20_p">Every campaign includes advanced tracking and reporting.</div></div></div><div class="service_list_container"><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Impressions</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Clicks</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Video Completion Rates</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Engagement Metrics</div></div><div class="tick_img"><img src="/webflow/images/6a9f3cb21b1a721a51846da6_Text.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Custom Reporting Labels</div></div></div><div class="service_inner_contain"><div class="_20_p">Our reporting is designed to align with DSP reporting to minimize discrepancies and provide accurate campaign insights.</div></div></div><div class="service_card_image"><img src="/webflow/images/6aae80bf66cd07ad164e86ce_ChatGPT-Image-Sep-19-2026-05_31_48-PM.png" loading="lazy" sizes="(max-width: 1536px) 100vw, 1536px" srcset="/webflow/images/6aae80bf66cd07ad164e86ce_ChatGPT-Image-Sep-19-2026-05_31_48-PM-p-500.png 500w, /webflow/images/6aae80bf66cd07ad164e86ce_ChatGPT-Image-Sep-19-2026-05_31_48-PM-p-800.png 800w, /webflow/images/6aae80bf66cd07ad164e86ce_ChatGPT-Image-Sep-19-2026-05_31_48-PM-p-1080.png 1080w, /webflow/images/6aae80bf66cd07ad164e86ce_ChatGPT-Image-Sep-19-2026-05_31_48-PM.png 1536w" alt="" class="service_image"/></div></div></div><div class="card-stack__item is--6"><div class="card_containers _6"><div class="service_content_head"><div class="tag_block_container"><div class="_22_p _600">06</div></div><div class="head_service_inner"><div class="_48_heading">Custom Video Enhancements</div><div class="service_inner_contain"><div class="_20_p">Extend the capabilities of video ads with custom solutions and integrations.</div></div></div><div class="service_list_container"><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Enhanced Video Experiences</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Custom Tracking</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Interactive Video Components</div></div><div class="tick_img"><img src="/webflow/images/6a94e0035bd78dccdf41dc30_tick-image.svg" loading="lazy" alt="" class="tick_block"/><div class="_18_p">Advanced Integrations</div></div></div><div class="service_inner_contain"><div class="_20_p">All creatives are custom built and optimized for performance.</div></div></div><div class="service_card_image"><img src="/webflow/images/6aae815476e3d9acaddc37ee_ChatGPT-Image-Sep-19-2026-05_34_20-PM.png" loading="lazy" sizes="(max-width: 1536px) 100vw, 1536px" srcset="/webflow/images/6aae815476e3d9acaddc37ee_ChatGPT-Image-Sep-19-2026-05_34_20-PM-p-500.png 500w, /webflow/images/6aae815476e3d9acaddc37ee_ChatGPT-Image-Sep-19-2026-05_34_20-PM-p-800.png 800w, /webflow/images/6aae815476e3d9acaddc37ee_ChatGPT-Image-Sep-19-2026-05_34_20-PM-p-1080.png 1080w, /webflow/images/6aae815476e3d9acaddc37ee_ChatGPT-Image-Sep-19-2026-05_34_20-PM.png 1536w" alt="" class="service_image"/></div></div></div></div></section><div class="w-embed"><style is:inline>
  .card-stack {
  --stack-row: 100svh;
  --stack-top: 10svh;
  --stack-card-height: calc(var(--stack-row) - 2 * var(--stack-top));
  view-timeline-name: --card-stack;
}

.card-stack__item:nth-child(1) { --stack-i: 1; }
.card-stack__item:nth-child(2) { --stack-i: 2; }
.card-stack__item:nth-child(3) { --stack-i: 3; }
.card-stack__item:nth-child(4) { --stack-i: 4; }
.card-stack__item:nth-child(5) { --stack-i: 5; } 
  
@supports (width: calc(sibling-index() * 1px)) {
  .card-stack__item { 
    --stack-i: sibling-index(); 
  }
}

@supports (animation-timeline: view()) {
  .card-stack__item {
    animation: card-stack-away linear forwards;
    animation-timeline: --card-stack;
    animation-range:
      exit-crossing calc(var(--stack-i, 1) * var(--stack-row) - 100svh)
      exit-crossing calc(var(--stack-i, 1) * var(--stack-row) - var(--stack-top));
  }

  .card-stack__item:last-of-type { 
    animation: none; 
  }  
}

@keyframes card-stack-away {
  to {
    transform: perspective(60em) rotateX(25deg) scale(0.85);
    filter: brightness(0.45);
  }
}

@media (prefers-reduced-motion: reduce) {
  .card-stack__item { 
    animation: none; 
  }
}
</style></div></div>


<script>
  // Phone slider controls for the service cards (dots + arrows). Hidden on desktop via mobile.css.
  const track = document.querySelector<HTMLElement>('.card-stack');
  if (track && !track.parentElement?.querySelector('.svc-nav')) {
    const items = Array.from(track.querySelectorAll<HTMLElement>('.card-stack__item'));
    const titles = items.map((it) => it.querySelector('._48_heading')?.textContent?.trim() || 'Service');
    const nav = document.createElement('div');
    nav.className = 'svc-nav';
    nav.innerHTML = `<div class="svc-dots" role="tablist" aria-label="Services"></div>
      <div class="svc-arrows">
        <button type="button" class="svc-arrow" data-dir="-1" aria-label="Previous service"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H6M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="svc-arrow" data-dir="1" aria-label="Next service"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>`;
    track.after(nav);
    const dotsBox = nav.querySelector<HTMLElement>('.svc-dots')!;
    const dots = items.map((_, i) => {
      const d = document.createElement('button');
      d.type = 'button';
      d.className = 'svc-dot';
      d.setAttribute('aria-label', `${i + 1}. ${titles[i]}`);
      d.addEventListener('click', () => go(i));
      dotsBox.appendChild(d);
      return d;
    });
    const [prev, next] = Array.from(nav.querySelectorAll<HTMLButtonElement>('.svc-arrow'));
    let current = 0;

    const go = (i: number) => {
      i = Math.max(0, Math.min(items.length - 1, i));
      const left = items[i].offsetLeft - items[0].offsetLeft;
      track.scrollTo({ left, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    const update = () => {
      const x = track.scrollLeft;
      let best = 0, dist = Infinity;
      items.forEach((it, i) => {
        const d = Math.abs(it.offsetLeft - items[0].offsetLeft - x);
        if (d < dist) { dist = d; best = i; }
      });
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) best = items.length - 1;
      current = best;
      dots.forEach((d, i) => { d.classList.toggle('is-active', i === best); d.setAttribute('aria-current', String(i === best)); });
      prev.disabled = best === 0;
      next.disabled = best === items.length - 1;
    };
    prev.addEventListener('click', () => go(current - 1));
    next.addEventListener('click', () => go(current + 1));
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
