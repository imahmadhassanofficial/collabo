---
// Cookie consent banner + preferences. Shown until the visitor chooses; the choice is saved in this browser
// (localStorage "collabo-cookie-consent") for 6 months. Reopen anywhere with a [data-cookie-settings] button.
//
// For developers — load a tracking script only after consent:
//   window.collaboConsent.onAllow('analytics', () => { /* add GA / Meta pixel etc. here */ });
// Categories: necessary (always on), analytics, marketing.
---
<div class="ck" role="region" aria-label="Cookie consent" hidden>
  <div class="ck__card">
    <div class="ck__main">
      <p class="ck__title">We use cookies</p>
      <p class="ck__text">
        We use necessary cookies to make this site work. With your permission we'd also like to use analytics and
        marketing cookies to understand how the site is used and improve our ads. You can change this at any time.
        <a href="/privacy-policy">Privacy Policy</a>
      </p>
    </div>

    <div class="ck__prefs" id="ck-prefs" hidden>
      <label class="ck__row">
        <span><b>Necessary</b><small>Needed for the site and forms to work. Always on.</small></span>
        <input type="checkbox" checked disabled />
      </label>
      <label class="ck__row">
        <span><b>Analytics</b><small>Helps us see which pages and demos people use.</small></span>
        <input type="checkbox" data-cat="analytics" />
      </label>
      <label class="ck__row">
        <span><b>Marketing</b><small>Used to measure and personalise our advertising.</small></span>
        <input type="checkbox" data-cat="marketing" />
      </label>
    </div>

    <div class="ck__actions">
      <button type="button" class="ck__btn is-ghost" data-ck="prefs" aria-expanded="false" aria-controls="ck-prefs">Preferences</button>
      <button type="button" class="ck__btn is-ghost" data-ck="reject">Reject all</button>
      <button type="button" class="ck__btn is-dark" data-ck="save" hidden>Save choices</button>
      <button type="button" class="ck__btn is-accent" data-ck="accept">Accept all</button>
    </div>
  </div>
</div>

<style is:global>
  .ck { position: fixed; left: 24px; bottom: 24px; z-index: 2147482000; width: min(460px, calc(100vw - 48px)); }
  .ck[hidden] { display: none; }
  .ck__card {
    background: #fff; color: #04091a; border-radius: 18px; padding: 22px;
    box-shadow: 0 24px 60px -18px rgba(4, 9, 26, 0.45), 0 0 0 1px rgba(28, 58, 96, 0.08);
    animation: ck-in .45s cubic-bezier(.2, .8, .2, 1);
  }
  @keyframes ck-in { from { opacity: 0; transform: translateY(20px); } }
  .ck__title { margin: 0 0 8px; font: 400 22px/1.2 Zodiak, Arial, sans-serif; }
  .ck__text { margin: 0; font: 400 14px/1.55 'Be Vietnam Pro', sans-serif; color: #4b5d74; }
  .ck__text a { color: #5a4fe0; text-decoration: underline; }
  .ck__prefs { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .ck__prefs[hidden] { display: none; }
  .ck__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; background: #f4f5f7; border-radius: 12px; padding: 12px 14px; cursor: pointer; margin: 0; font-weight: 400; }
  .ck__row span { display: flex; flex-direction: column; gap: 2px; }
  .ck__row b { font: 500 14px/1.3 'Be Vietnam Pro', sans-serif; color: #1c3a60; }
  .ck__row small { font: 400 12px/1.4 'Be Vietnam Pro', sans-serif; color: #677b94; }
  /* toggle switch */
  .ck__row input { appearance: none; -webkit-appearance: none; flex: none; width: 40px; height: 22px; margin: 0; border-radius: 99px; background: #c9d1dc; position: relative; cursor: pointer; transition: background .2s; }
  .ck__row input::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
  .ck__row input:checked { background: #5a4fe0; }
  .ck__row input:checked::after { transform: translateX(18px); }
  .ck__row input:disabled { opacity: .55; cursor: default; }
  .ck__row input:focus-visible { outline: 2px solid #5a4fe0; outline-offset: 2px; }
  .ck__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .ck__btn { flex: 1 1 auto; height: 44px; padding: 0 16px; border-radius: 99px; border: 0; cursor: pointer; white-space: nowrap; font: 400 14px/1 'Be Vietnam Pro', sans-serif; transition: transform .15s, background-color .2s; }
  .ck__btn[hidden] { display: none; }
  .ck__btn:hover { transform: translateY(-1px); }
  .ck__btn.is-ghost { background: #fff; color: #1c3a60; box-shadow: inset 0 0 0 1.5px #1c3a60; }
  .ck__btn.is-dark { background: #04091a; color: #fff; }
  .ck__btn.is-accent { background: linear-gradient(90deg, #f78071, #f2a74b); color: #04091a; }
  .ck__btn:focus-visible { outline: 2px solid #5a4fe0; outline-offset: 2px; }
  @media (max-width: 599px) {
    .ck { left: 12px; right: 12px; bottom: 12px; width: auto; }
    .ck__card { padding: 18px; max-height: calc(100dvh - 24px); overflow: auto; }
    .ck__title { font-size: 20px; }
    .ck__btn { flex: 1 1 calc(50% - 4px); }
    .ck__btn.is-accent, .ck__btn.is-dark { flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .ck__card { animation: none; } }
</style>

<script is:inline>
(() => {
  const KEY = 'collabo-cookie-consent';
  const VERSION = 1;               // bump to ask everyone again (e.g. after adding a new tracker)
  const MAX_AGE = 1000 * 60 * 60 * 24 * 182; // ~6 months
  const root = document.querySelector('.ck');
  if (!root) return;
  const prefs = root.querySelector('#ck-prefs');
  const btn = (n) => root.querySelector(`[data-ck="${n}"]`);
  const boxes = [...root.querySelectorAll('input[data-cat]')];
  const listeners = [];

  const read = () => {
    try {
      const v = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (!v || v.v !== VERSION || Date.now() - v.at > MAX_AGE) return null;
      return v;
    } catch (e) { return null; }
  };
  let state = read();

  function fire() {
    listeners.forEach((l) => { if (!l.done && state && state[l.cat]) { l.done = true; try { l.fn(); } catch (e) {} } });
    window.dispatchEvent(new CustomEvent('consent:change', { detail: state }));
  }
  function save(analytics, marketing) {
    state = { v: VERSION, at: Date.now(), necessary: true, analytics, marketing };
    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
    hide(); fire();
  }
  function setPrefs(open) {
    prefs.hidden = !open;
    btn('prefs').setAttribute('aria-expanded', String(open));
    btn('prefs').hidden = open;
    btn('save').hidden = !open;
  }
  function show(openPrefs = false) {
    boxes.forEach((b) => (b.checked = !!(state && state[b.dataset.cat])));
    setPrefs(openPrefs);
    root.hidden = false;
  }
  function hide() { root.hidden = true; }

  btn('accept').addEventListener('click', () => save(true, true));
  btn('reject').addEventListener('click', () => save(false, false));
  btn('prefs').addEventListener('click', () => setPrefs(true));
  btn('save').addEventListener('click', () => {
    const get = (c) => boxes.find((b) => b.dataset.cat === c).checked;
    save(get('analytics'), get('marketing'));
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden && state) hide(); });

  // Any element with data-cookie-settings reopens the panel (e.g. the footer link)
  document.addEventListener('click', (e) => {
    const t = e.target.closest('[data-cookie-settings]');
    if (t) { e.preventDefault(); show(true); }
  });

  window.collaboConsent = {
    get: () => state,
    allowed: (cat) => cat === 'necessary' || !!(state && state[cat]),
    onAllow: (cat, fn) => { const l = { cat, fn, done: false }; listeners.push(l); if (state && state[cat]) { l.done = true; fn(); } },
    open: () => show(true),
  };

  // First visit: wait until the dropping-cards loader has finished so they don't overlap
  if (!state) {
    if (document.documentElement.classList.contains('cl-loading')) {
      window.addEventListener('collabo:loader-done', () => setTimeout(() => show(), 400), { once: true });
    } else {
      setTimeout(() => show(), 800);
    }
  } else {
    fire();
  }
})();
</script>
