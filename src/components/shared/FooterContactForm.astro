---
// Map + "Tell us about your goals" form shown above the footer on Home and legal pages.
// wfPage = the Webflow page id, used by Webflow's form handler.
const { wfPage } = Astro.props;
---
<div class="footer_form_container"><div class="footer_form_section"><div class="form_blocks"><div class="footer_form_map"><div class="form_map_container"><div class="map w-widget w-widget-map" data-widget-style="roadmap" data-widget-latlng="33.5106965,-112.0157274" data-enable-scroll="true" role="region" title="" data-enable-touch="true" data-widget-zoom="12" data-widget-tooltip=""></div></div><div class="form_map_content"><div class="form_content_container"><div class="logo_image_contain"><img loading="lazy" src="/webflow/images/6a6a7fc1cb3e6ea1b27a98f4_logo-icon.svg" alt=""/></div><div class="logo_list_container"><div class="collabo_head"><div class="logo_map_heading"><div class="_40_text">Collabo</div></div><div class="collabo_description"><div class="_24_paragraph _300">To be the trusted partner for brands, agencies, and publishers navigating the future of digital advertising.</div></div></div><div class="footer_test"><div class="head_sections"><div class="_14_p">Email: : </div></div><div class="_24_paragraph">info@collaboLLC.com</div></div></div></div></div></div><div class="form_containers"><div class="form_head_block"><div class="form_heading"><div class="_48_heading">Tell us about your goals</div></div><div class="form_head"><div class="form_contains w-form"><form id="email-form" name="email-form" data-name="Email Form" method="get" class="form_blck" data-wf-page-id={wfPage} data-wf-element-id="a4d37e32-a875-5371-0331-86e2dee748db" data-turnstile-sitekey="0x4AAAAAAAQTptj2So4dx43e"><div class="form_inner_container"><div class="form_input_container"><input class="input_block w-input" maxlength="256" name="email" data-name="Email" placeholder="Enter your name" type="email" id="email" required=""/><div class="input_block_container"><input class="input_block w-node-a4d37e32-a875-5371-0331-86e2dee748e0-dee748bb w-input" maxlength="256" name="email" data-name="Email" placeholder="Enter your email" type="email" id="email" required=""/><input class="input_block w-node-a4d37e32-a875-5371-0331-86e2dee748e1-dee748bb w-input" maxlength="256" name="email" data-name="Email" placeholder="Enter your phone" type="email" id="email" required=""/></div><div class="input_blocks"><div class="_24_vietnam">What do you want to create?</div><textarea id="field" name="field" maxlength="5000" data-name="Field" placeholder="Share your ideas" class="text_area_container w-input"></textarea></div></div><input type="submit" data-wait="Submit Your Form" class="form_btn_contain w-button" value="Submit Your Form"/></div></form><div class="w-form-done"><div>Thank you! Your submission has been received!</div></div><div class="w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div></div></div></div></div></div></div></div>
