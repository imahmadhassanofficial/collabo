---
// Shared Webflow header (.header-2). Pass current="contact" / current="work" on those pages.
const { current } = Astro.props;
const isContact = current === 'contact';
const isWork = current === 'work';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const isPrivacy = path === '/privacy-policy';
const isTerms = path === '/terms-and-conditions';
---
<header class="header-2 ch">
  <a href="/" aria-label="Collabo home" class="header_logo_container ch-logo"><img src="/brand/logo-collabo-light.svg" alt="Collabo" class="logo_image-2" width="219" height="46" /></a>
  <nav class="ch-nav" aria-label="Main">
    <a href="/" aria-current={isHome ? "page" : undefined}>Home</a>
    <a href="/#services">Services</a>
    <a href="/#process">Process</a>
    <a href="/work" aria-current={isWork ? "page" : undefined}>Work</a>
    <a href="/contact" aria-current={isContact ? "page" : undefined}>Contact</a>
  </nav>
  <div class="ch-actions">
    <a href="tel:+14808856858" class="ch-phone"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.58 3.57a1 1 0 0 1-.25 1L6.6 10.8Z" fill="currentColor"/></svg>(480) 885-6858</a>
    <a href="/contact" class="ch-cta"><i class="ch-dot" aria-hidden="true"></i>Start a Conversation <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </div>
  <button aria-label="Open menu" class="m-menu-btn" type="button" aria-expanded="false" aria-controls="m-menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><svg class="m-menu-btn__x" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
</header>
<!-- Phone-only full-screen menu (hidden on desktop by src/styles/mobile.css) -->
<nav id="m-menu" class="m-menu" aria-label="Main" tabindex="-1" hidden>
  <div class="mm-top">
    <a href="/" class="mm-logo" aria-label="Collabo home"><img src="/brand/logo-collabo-light.svg" alt="Collabo" width="120" height="25" /></a>
    <button class="m-menu__close mm-close" type="button" aria-label="Close menu">Close <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  </div>
  <p class="mm-status"><i aria-hidden="true"></i>We typically reply within a few hours</p>
  <ul class="m-menu__list">
    <li><a href="/" aria-current={isHome ? "page" : undefined}><span>Home</span><small>01</small></a></li>
    <li><a href="/work" aria-current={isWork ? "page" : undefined}><span>Work</span><small>02</small></a></li>
    <li><a href="/#services"><span>Services</span><small>03</small></a></li>
    <li><a href="/#process"><span>Process</span><small>04</small></a></li>
    <li><a href="/contact" aria-current={isContact ? "page" : undefined}><span>Contact</span><small>05</small></a></li>
  </ul>
  <div class="mm-bottom">
    <a href="/contact" class="mm-cta">Start a Conversation <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    <ul class="mm-links">
      <li><a href="mailto:info@collaboLLC.com">Email</a></li>
      <li><a href="tel:+14808856858">Call</a></li>
      <li><a href="/privacy-policy" aria-current={isPrivacy ? "page" : undefined}>Privacy</a></li>
      <li><a href="/terms-and-conditions" aria-current={isTerms ? "page" : undefined}>Terms</a></li>
    </ul>
    <p class="mm-meta">Phoenix, AZ · <span data-mm-clock>--:--</span> MST</p>
  </div>
</nav>
<script is:inline>
(() => {
  const btn = document.querySelector('.m-menu-btn');
  const menu = document.getElementById('m-menu');
  if (!btn || !menu) return;
  const set = (open) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('m-menu-open', open);
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) menu.focus({ preventScroll: true }); else btn.focus({ preventScroll: true });
  };
  btn.addEventListener('click', () => set(menu.hidden));
  menu.querySelector('.mm-close').addEventListener('click', () => set(false));
  // Phoenix local time in the menu footer (Arizona stays on MST all year)
  const clock = menu.querySelector('[data-mm-clock]');
  const tick = () => { clock.textContent = new Intl.DateTimeFormat('en-US', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Phoenix' }).format(new Date()); };
  tick(); setInterval(tick, 30000);
  menu.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) set(false); });
  matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches && !menu.hidden) set(false); });
})();
</script>

<style is:global>
  /* Transparent header: it overlaps the top of each page's hero, so the hero's background runs behind it.
     The hero gets the header's height back as extra top padding. */
  html body .header-2.ch:not(#_z):not(#_y) { margin-bottom: -84px; }
  html body .header-2.ch ~ .hero_game_container:not(#_z):not(#_y) { padding-top: calc(6.5vw + 84px); }
  html body .header-2.ch ~ .head_block:not(#_z):not(#_y) { padding-top: 84px; }
  @media (max-width: 899px) {
    html body .header-2.ch:not(#_z):not(#_y) { margin-bottom: -64px; }
    html body .header-2.ch ~ .hero_game_container:not(#_z):not(#_y) { padding-top: 120px; }
    html body .header-2.ch ~ .head_block:not(#_z):not(#_y) { padding-top: 64px; }
  }
  /* Dark brand header that sits on the dark hero (desktop + tablet layout; phones use mobile.css) */
  html body .header-2.ch:not(#_z) { background: transparent; color: #fff; -webkit-backdrop-filter: none; backdrop-filter: none; }
  @media (min-width: 900px) {
    html body .header-2.ch:not(#_z) {
      position: relative; z-index: 999; display: flex; align-items: center; justify-content: space-between; gap: 24px;
      height: 84px; padding: 0 2.5vw; border-bottom: 1px solid rgba(255, 255, 255, .06);
    }
    html body .ch .header_logo_container:not(#_z) { padding: 0; display: flex; align-items: center; }
    html body .ch .logo_image-2:not(#_z) { width: 150px; height: auto; }
  }
  .ch-nav { position: absolute; left: 50%; translate: -50% 0; display: flex; align-items: center; gap: 4px; }
  .ch-nav a {
    position: relative; padding: 10px 16px; border-radius: 99px; color: rgba(255, 255, 255, .72); text-decoration: none;
    font: 400 15px/1 'Be Vietnam Pro', sans-serif; transition: color .2s, background-color .2s;
  }
  .ch-nav a:hover { color: #fff; background: rgba(255, 255, 255, .06); }
  .ch-nav a[aria-current="page"] { color: #fff; }
  .ch-nav a[aria-current="page"]::after {
    content: ''; position: absolute; left: 50%; bottom: 2px; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%;
    background: linear-gradient(90deg, #f98670, #ed6673);
  }
  .ch-actions { display: flex; align-items: center; gap: 10px; }
  .ch-phone, .ch-cta {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 99px;
    font: 500 14px/1 'Be Vietnam Pro', sans-serif; text-decoration: none; white-space: nowrap; transition: transform .2s, background-color .2s, border-color .2s, box-shadow .2s;
  }
  .ch-phone { color: #fff; border: 1px solid rgba(255, 255, 255, .22); }
  .ch-phone:hover { border-color: #26aeee; background: rgba(38, 174, 238, .08); }
  .ch-cta { color: #04091a; background: #ed6673; box-shadow: 0 10px 30px -12px rgba(237, 102, 115, .8); }
  .ch-cta:hover { transform: translateY(-1px); background: #f98670; }
  .ch-cta svg { transition: translate .2s; }
  .ch-cta:hover svg { translate: 3px 0; }
  .ch-dot { width: 7px; height: 7px; border-radius: 50%; background: #04091a; box-shadow: 0 0 0 0 rgba(4, 9, 26, .5); animation: ch-pulse 2s infinite; }
  @keyframes ch-pulse { 70% { box-shadow: 0 0 0 7px rgba(4, 9, 26, 0); } 100% { box-shadow: 0 0 0 0 rgba(4, 9, 26, 0); } }
  .ch a:focus-visible, .ch button:focus-visible { outline: 2px solid #26aeee; outline-offset: 3px; }
  @media (max-width: 1199px) { .ch-phone { display: none; } .ch-nav a { padding: 10px 11px; } }
  @media (max-width: 899px) { .ch-nav, .ch-actions { display: none; } }
  @media (prefers-reduced-motion: reduce) { .ch-dot { animation: none; } }
</style>
