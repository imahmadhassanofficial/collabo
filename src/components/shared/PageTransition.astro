---
// Page transition panel used by Barba (see BarbaRouter.astro).
// Same dark night-sky look as the hero: dark base, brand colour glows and a dot field.
// Leave: the panel draws down over the page from the top. Enter: it carries on down and off the bottom,
// uncovering the new page. window.collaboTransition.cover() / .reveal() return promises.
---
<div class="pt" aria-hidden="true">
  <div class="pt__glow"></div>
  <div class="pt__dots"></div>
  <div class="pt__edge"></div>
  <img class="pt__logo" src="/webflow/images/6a6a7fc1cb3e6ea1b27a98f4_logo-icon.svg" alt="" width="56" height="56" />
</div>

<style is:global>
  .pt {
    position: fixed; inset: 0; z-index: 2147483000; pointer-events: none; overflow: hidden;
    background: #07070d; clip-path: inset(0 0 100% 0); visibility: hidden;
  }
  html.pt-busy .pt { pointer-events: auto; }
  .pt__glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 12% 30%, rgba(48, 107, 231, .42), rgba(90, 79, 224, .14) 26%, rgba(48, 107, 231, 0) 50%),
      radial-gradient(circle at 88% 70%, rgba(155, 46, 194, .42), rgba(237, 102, 115, .14) 26%, rgba(155, 46, 194, 0) 50%);
  }
  .pt__dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, .5) 1px, transparent 1.4px); background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 var(--pt-d, 0%), transparent calc(var(--pt-d, 0%) + 18%));
            mask-image: linear-gradient(180deg, #000 0%, #000 var(--pt-d, 0%), transparent calc(var(--pt-d, 0%) + 18%));
    opacity: .55;
  }
  /* soft brand-coloured leading edge at the bottom of the panel */
  .pt__edge {
    position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: linear-gradient(90deg, #26aeee, #5a4fe0, #9b2ec2, #ed6673);
    box-shadow: 0 0 24px 6px rgba(90, 79, 224, .55);
  }
  .pt__logo { position: absolute; left: 50%; top: 50%; width: 56px; height: 56px; translate: -50% -50%; opacity: 0; }
</style>

<script is:inline>
  (function () {
    if (window.collaboTransition) return;
    var el = document.querySelector('.pt');
    if (!el) return;
    var dots = el.querySelector('.pt__dots'), logo = el.querySelector('.pt__logo'), edge = el.querySelector('.pt__edge');
    var root = document.documentElement;
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var EASE = 'cubic-bezier(0.76, 0, 0.24, 1)';
    var D = reduced ? 1 : 750;

    // resolve when the animation ends, or after its duration anyway (background tabs don't run animations)
    function done(a) {
      return Promise.race([a.finished.catch(function () {}), new Promise(function (r) { setTimeout(r, D + 400); })])
        .then(function () { try { a.finish(); } catch (e) {} });
    }

    function cover() {
      root.classList.add('pt-busy');
      el.style.visibility = 'visible';
      edge.style.opacity = '1';
      var a = el.animate([{ clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)' }], { duration: D, easing: EASE, fill: 'forwards' });
      // dots sweep in from the top, just behind the panel's leading edge
      dots.animate([{ '--pt-d': '-20%' }, { '--pt-d': '100%' }], { duration: D * 1.15, easing: 'ease-out', fill: 'forwards' });
      logo.animate([{ opacity: 0, transform: 'scale(.85)' }, { opacity: 1, transform: 'scale(1)' }], { duration: 400, delay: D * .55, easing: 'ease-out', fill: 'forwards' });
      return done(a).then(function () { edge.style.opacity = '0'; });
    }

    function reveal() {
      edge.style.opacity = '0';
      logo.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, easing: 'ease-in', fill: 'forwards' });
      var a = el.animate([{ clipPath: 'inset(0 0 0 0)' }, { clipPath: 'inset(100% 0 0 0)' }], { duration: D, delay: reduced ? 0 : 120, easing: EASE, fill: 'forwards' });
      return done(a).then(function () {
        el.getAnimations({ subtree: true }).forEach(function (x) { x.cancel(); });
        el.style.visibility = 'hidden';
        root.classList.remove('pt-busy');
      });
    }

    // the dot mask animates a custom property, so register it as a length-percentage
    try { CSS.registerProperty({ name: '--pt-d', syntax: '<length-percentage>', inherits: false, initialValue: '0%' }); } catch (e) {}

    window.collaboTransition = { cover: cover, reveal: reveal };
  })();
</script>
